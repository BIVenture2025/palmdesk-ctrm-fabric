table 'Attribution Bucket Calculation Group'
	lineageTag: c2cd2eff-7c75-5dee-b2cc-6bdd59885e23

	calculationGroup
		precedence: 10

		calculationItem 'New trades' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 1
				)

		calculationItem Price =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 2
				)

		calculationItem FX =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 3
				)

		calculationItem Time =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 4
				)

		calculationItem 'Amendments and cancellations' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 5
				)

		calculationItem Unexplained =
				CALCULATE (
				    SELECTEDMEASURE (),
				    REMOVEFILTERS ( 'Bucket' ),
				    'Bucket'[bucket_no] = 6
				)


	/// Physical contracts in context.
	measure 'Contracts' = COUNTROWS ( 'Physical Contract' )
		formatString: 0
		lineageTag: c1cf3d26-42d2-5806-ae6c-625bb2aa0a29

	/// Confirmed tonnage across the physical contracts in context.
	measure 'Contract Notional (MT)' = SUM ( 'Physical Contract'[confirmed_qty_mt] )

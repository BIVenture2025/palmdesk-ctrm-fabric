table 'Currency Calculation Group'
	lineageTag: ff1c60c4-ef0a-5515-8e0d-39131efdff08

	calculationGroup
		precedence: 30

		calculationItem MYR = SELECTEDMEASURE ()

		calculationItem USD =
				VAR _isMYR = CONTAINSSTRING ( SELECTEDMEASURENAME (), "(MYR)" )
				VAR _rate = [USDMYR Rate]
				RETURN
				IF (
				    _isMYR && NOT ISBLANK ( _rate ),
				    DIVIDE ( SELECTEDMEASURE (), _rate ),
				    SELECTEDMEASURE ()
				)

	column Currency
		dataType: string
		lineageTag: eecef47a-6774-577c-a06d-8dc60b9809aa
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f77bb5a7-3d59-5b9e-adb4-afb9a5c8adfc
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

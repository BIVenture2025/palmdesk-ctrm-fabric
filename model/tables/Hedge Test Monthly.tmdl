table 'Hedge Test Monthly'
	lineageTag: 4e3fadb3-c1a3-5b70-9261-93e8b7b5844e
	sourceLineageTag: hedge_test_monthly

	/// Relationship-months actually assessed. A month whose cumulative hedged-item change is under 1% of notional is not assessed (the de minimis floor, contract section 6).
	measure 'Assessments' = CALCULATE ( COUNTROWS ( 'Hedge Test Monthly' ), 'Hedge Test Monthly'[assessed] = TRUE () )
		formatString: 0
		lineageTag: 79ec0a0f-c812-57c6-b3ef-485d3a42c7c1

	/// Assessed relationship-months that passed the dollar-offset test.
	measure 'Assessments Effective' = CALCULATE ( COUNTROWS ( 'Hedge Test Monthly' ), 'Hedge Test Monthly'[assessed] = TRUE (), 'Hedge Test Monthly'[effective] = TRUE () )
		formatString: 0
		lineageTag: 198aabc0-8d6c-585f-8c17-7db7d08972d9

	/// Assessed relationship-months that failed.
	measure 'Assessments Failing' = [Assessments] - [Assessments Effective]
		formatString: 0
		lineageTag: 89069dc0-f631-5b9d-9a21-5399bfdaa827

	/// Share of assessed relationship-months that passed.
	measure 'Hedge Pass Rate' = DIVIDE ( [Assessments Effective], [Assessments] )
		formatString: 0.0%
		lineageTag: ce259b50-129f-56c9-aba2-2ff4f6f4e059

	/// Cumulative change in the hedging instrument over the cumulative change in the hedged item. IAS 39 style band: -1.25 to -0.80.
	measure 'Dollar Offset' = AVERAGE ( 'Hedge Test Monthly'[dollar_offset] )
		formatString: 0.0000
		lineageTag: ce9a5b40-2158-5d23-9fd8-e0abb250044d

	/// Regression slope of the prospective effectiveness test.
	measure 'Prospective Slope' = AVERAGE ( 'Hedge Test Monthly'[prospective_slope] )
		formatString: 0.0000
		lineageTag: 94e1ce04-4d40-5f50-95ec-abf5ae01646f

	/// Regression R-squared of the prospective effectiveness test.
	measure 'Prospective R2' = AVERAGE ( 'Hedge Test Monthly'[prospective_r2] )
		formatString: 0.0000
		lineageTag: 6e6f3b37-dc7d-5369-a105-04ec2790d7af

	/// Ineffectiveness recognised in profit or loss.
	measure 'Ineffectiveness to P&L (MYR)' = SUM ( 'Hedge Test Monthly'[ineffectiveness_pl] )
		formatString: #,##0
		lineageTag: fbbdde09-47b6-5902-8ef0-16b773d64b39

	/// Cash flow hedge reserve carried in other comprehensive income at the close of the months in context.
	measure 'OCI Closing (MYR)' = SUM ( 'Hedge Test Monthly'[oci_close] )
		formatString: #,##0
		lineageTag: da4526c3-39bf-5dae-a104-3e8a8ba3cf89

	/// Amounts recycled out of OCI to profit or loss.
	measure 'OCI Reclassified (MYR)' = SUM ( 'Hedge Test Monthly'[oci_reclassified] )
		formatString: #,##0
		lineageTag: 9422bda8-bef7-542a-b30b-1338ce45c2a0

	measure 'Assessments alt text' = "Relationship-months assessed: " & FORMAT ( [Assessments], "0" ) & "."
		isHidden
		lineageTag: 9fd2bef8-996c-54f0-9aeb-14ce1098ac26

	measure 'Assessments Effective alt text' = "Assessed months passing the dollar-offset test: " & FORMAT ( [Assessments Effective], "0" ) & "."
		isHidden
		lineageTag: 9dc8a380-4a42-5a8d-829b-6c940587d675

	measure 'Assessments Failing alt text' = "Assessed relationship-months that failed: " & FORMAT ( [Assessments Failing], "0" ) & "."
		isHidden
		lineageTag: 422c3f15-326b-58ca-9bc7-d8f687542e20

	measure 'Hedge Pass Rate alt text' = "Share of assessed relationship-months that passed: " & FORMAT ( [Hedge Pass Rate], "0.0%" ) & "."
		isHidden
		lineageTag: da06ac76-feb5-5f0b-a67c-508262b9249f

	measure 'Ineffectiveness alt text' = "Ineffectiveness to profit or loss: " & FORMAT ( [Ineffectiveness to P&L (MYR)], "#,##0" ) & " MYR."
		isHidden
		lineageTag: 999cab66-7b6e-56df-94e3-3bd0c6c4538f

	measure 'OCI Closing alt text' = "Cash flow hedge reserve in OCI: " & FORMAT ( [OCI Closing (MYR)], "#,##0" ) & " MYR."
		isHidden
		lineageTag: 546fedde-f757-51c0-9af6-a9ce24944b39

	measure 'Hedge table alt text' = "Dollar offset, prospective R squared and ineffectiveness by month and relationship. " & FORMAT ( [Assessments Effective], "0" ) & " of " & FORMAT ( [Assessments], "0" ) & " pass."
		isHidden
		lineageTag: caf4ff45-c4d3-52cc-a173-071a878e079b

	measure 'Offset chart alt text' = "Average dollar-offset ratio by month. Window average " & FORMAT ( [Dollar Offset], "0.0000" ) & "."
		isHidden
		lineageTag: 98919059-7062-56a4-8d56-ffe3d7c1a1d2

